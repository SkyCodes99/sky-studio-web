{
  "skyplugin": 1,
  "version": "1.0",
  "author": "Sky Studio",
  "id": "skystudio.glassharp",
  "kind": "instrument",
  "name": "Glass Harp",
  "category": "Plugins",
  "desc": "Airy, shimmering glass tones that bloom and fade slowly.",
  "spec": {
    "level": 0.85,
    "lp": 14000,
    "a": 0.004,
    "r": 0.9
  },
  "render": "function render(midi, sr) {\n  const f = api.mtof(midi), len = Math.floor(sr * 4), out = new Float32Array(len);\n  const partials = [[1, 1, 0.6], [2.0, 0.55, 0.9], [2.99, 0.4, 1.2], [4.02, 0.22, 1.6], [5.43, 0.12, 2.2], [6.8, 0.07, 3.0]];\n  for (const [ratio, amp, decay] of partials) {\n    const fn = f * ratio; if (fn > sr * 0.45) continue;\n    for (let beat = 0; beat < 2; beat++) {                       // two slightly detuned copies make the shimmer\n      const fd = fn * (beat ? 1.0028 : 0.9972), w = api.TWO_PI * fd / sr, ph0 = beat * 1.3;\n      const tau = 1.6 / decay;\n      for (let i = 0; i < len; i++) out[i] += Math.sin(w * i + ph0) * amp * 0.5 * Math.exp(-i / sr / tau);\n    }\n  }\n  const att = Math.floor(sr * 0.012);\n  for (let i = 0; i < att; i++) out[i] *= i / att;\n  return out;\n}"
}
